#!/usr/bin/expect -f
# Public disposable fixture; never use this value outside this PTY-only harness.
set public_fixture "AstrBotPublicTest2026A"
log_user 0
log_file /dev/null
exp_internal 0
set timeout 20

if {[llength $argv] != 2 && [llength $argv] != 3} {
    exit 64
}

set controller [lindex $argv 0]
set instance [lindex $argv 1]
set request_body [expr {[llength $argv] == 3 ? [lindex $argv 2] : ""}]
set saw_password 0
set saw_confirmation 0

spawn sudo bash $controller password --username astrbot $instance
expect {
    -re {New dashboard password:} {
        set saw_password 1
        send -- "$public_fixture\r"
        exp_continue
    }
    -re {Repeat for confirmation:} {
        set saw_confirmation 1
        send -- "$public_fixture\r"
        exp_continue
    }
    timeout { exit 1 }
    eof {}
}

if {!$saw_password || !$saw_confirmation} { exit 1 }
if {[catch wait wait_result]} { exit 1 }
if {[lindex $wait_result 3] != 0} { exit [lindex $wait_result 3] }

# The caller pre-creates this mode-0600 file.  Keeping the public fixture here
# avoids secret text in argv, environment, or the shell harness.
if {$request_body ne ""} {
    set body_file [open $request_body "w"]
    puts -nonewline $body_file "{\"username\":\"astrbot\",\"password\":\"$public_fixture\"}"
    close $body_file
}
exit 0
